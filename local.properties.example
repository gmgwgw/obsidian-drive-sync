# Copy this file to local.properties (do NOT commit local.properties to Git).
# Windows SDK path example (double backslashes or forward slashes):
sdk.dir=C:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Android)
GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
